# Copy to .env.local (never commit real values).
# Supabase project: Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the public form endpoint, invitations and scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Public address of this app (used in form links and certificate verification QR codes)
NEXT_PUBLIC_SITE_URL=https://office.petvax.org

# Certificate email (https://resend.com). Leave empty to disable sending; attempts are logged as "not configured".
RESEND_API_KEY=
EMAIL_FROM=PetVax <certificates@petvax.org>
EMAIL_REPLY_TO=petvaxnyc@gmail.com

# Jotform import only (read-only API key from Jotform > Settings > API). Not needed by the app.
JOTFORM_API_KEY=
# JOTFORM_API_BASE=https://api.jotform.com   # eu-api.jotform.com or hipaa-api.jotform.com for those accounts

# Backups against the hosted database only (Dashboard > Connect > Session pooler URI)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
